datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =====================================================
// ENUMS
// =====================================================

enum OrganizationType {
  COLLECTION_CENTER
  TRANSPORT_COMPANY
  RECYCLING_FACILITY
}

enum DeviceStatus {
  REGISTERED
  AWAITING_COLLECTION
  COLLECTED
  IN_TRANSIT
  RECEIVED
  UNDER_INSPECTION
  MATERIAL_RECOVERY
  DISPOSED
  COMPLETED
}

enum CollectionMethod {
  PICKUP
  DROP_OFF
}

enum RecyclingRequestStatus {
  PENDING
  ACCEPTED
  SCHEDULED
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PickupStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum EventType {
  REGISTERED
  COLLECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  MATERIAL_RECOVERY
  DISPOSAL
  COMPLETED
}

// =====================================================
// USER
// =====================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())

  // User's devices
  devices Device[]

  // Events performed by this user
  events Event[]

  // Ledger verification records
  verifications Verification[]

  // Optional organization membership
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

// =====================================================
// ORGANIZATION
// =====================================================

model Organization {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  type          OrganizationType
  licenseNumber String
  contactEmail  String
  createdAt     DateTime         @default(now())

  locations Location[]

  // Employees/users belonging to organization
  users User[]

  // Events performed by this organization
  events Event[] @relation("EventOrganization")

  // Requests assigned to organization
  recyclingRequests RecyclingRequest[]

  // Events where this organization is sender
  outgoingEvents Event[] @relation("EventFromOrganization")

  // Events where this organization is receiver
  incomingEvents Event[] @relation("EventToOrganization")
}

// =====================================================
// LOCATION
// =====================================================

model Location {
  id             String  @id @default(uuid()) @db.Uuid
  city           String
  state          String
  address        String
  latitude       Decimal @db.Decimal(10, 7)
  longitude      Decimal @db.Decimal(10, 7)
  organizationId String  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// =====================================================
// DEVICE CATEGORY
// =====================================================

model DeviceCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  devices Device[]
}

// =====================================================
// DEVICE
// =====================================================

model Device {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  ownerId    String @db.Uuid

  brand           String
  model           String
  serialNumber    String?
  manufactureYear Int?

  currentStatus DeviceStatus @default(REGISTERED)

  createdAt DateTime @default(now())

  category DeviceCategory @relation(fields: [categoryId], references: [id])

  owner User @relation(fields: [ownerId], references: [id])

  // Recycling requests for this device
  recyclingRequests RecyclingRequest[]

  // Lifecycle events
  events Event[]

  // Ledger chain for this device
  ledgerEntries LedgerEntry[]

  // Verification records
  verifications Verification[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([currentStatus])
  @@index([serialNumber])
}

// =====================================================
// RECYCLING REQUEST
// =====================================================

model RecyclingRequest {
  id String @id @default(uuid()) @db.Uuid

  deviceId String @db.Uuid

  // Organization selected by the user
  organizationId String @db.Uuid

  collectionMethod CollectionMethod

  status RecyclingRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  // Exists only when collection method = PICKUP
  pickupRequest PickupRequest?

  @@index([deviceId])
  @@index([organizationId])
  @@index([status])
}

// =====================================================
// PICKUP REQUEST
// =====================================================

model PickupRequest {
  id String @id @default(uuid()) @db.Uuid

  recyclingRequestId String @unique @db.Uuid

  pickupAddress String

  requestedDate DateTime
  scheduledDate DateTime?

  status PickupStatus @default(PENDING)

  createdAt DateTime @default(now())

  recyclingRequest RecyclingRequest @relation(fields: [recyclingRequestId], references: [id])

  @@index([status])
}

// =====================================================
// EVENT
// =====================================================

model Event {
  id String @id @default(uuid()) @db.Uuid

  deviceId String @db.Uuid

  eventType EventType

  // User who performed/recorded the event
  performedBy String @db.Uuid

  // Organization responsible for the event
  organizationId String? @db.Uuid

  // Used for transfers such as IN_TRANSIT
  fromOrganizationId String? @db.Uuid
  toOrganizationId   String? @db.Uuid

  remarks String?

  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  performer User @relation(fields: [performedBy], references: [id])

  organization Organization? @relation("EventOrganization", fields: [organizationId], references: [id])

  fromOrganization Organization? @relation("EventFromOrganization", fields: [fromOrganizationId], references: [id])

  toOrganization Organization? @relation("EventToOrganization", fields: [toOrganizationId], references: [id])

  // One event can have multiple recovered materials
  materialRecoveries MaterialRecovery[]

  // Disposal event has one disposal record
  disposalRecord DisposalRecord?

  // Every event gets exactly one ledger entry
  ledgerEntry LedgerEntry?

  @@index([deviceId])
  @@index([eventType])
  @@index([organizationId])
  @@index([fromOrganizationId])
  @@index([toOrganizationId])
  @@index([createdAt])
}

// =====================================================
// MATERIAL
// =====================================================

model Material {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  recoveries MaterialRecovery[]
}

// =====================================================
// MATERIAL RECOVERY
// =====================================================

model MaterialRecovery {
  id String @id @default(uuid()) @db.Uuid

  eventId    String @db.Uuid
  materialId String @db.Uuid

  quantity Decimal @db.Decimal(10, 3)

  unit String

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  material Material @relation(fields: [materialId], references: [id])

  @@index([eventId])
  @@index([materialId])
}

// =====================================================
// DISPOSAL RECORD
// =====================================================

model DisposalRecord {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @db.Uuid

  wasteType      String
  disposalMethod String

  disposalDate DateTime

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

// =====================================================
// CRYPTOGRAPHIC LEDGER
// =====================================================

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  // One ledger entry belongs to exactly one event
  eventId String @unique @db.Uuid

  // Device this chain belongs to
  deviceId String @db.Uuid

  // Previous entry in THIS DEVICE'S chain
  previousLedgerId String? @db.Uuid

  previousHash String?
  currentHash  String  @unique

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  device Device @relation(fields: [deviceId], references: [id])

  previousLedger LedgerEntry? @relation("LedgerChain", fields: [previousLedgerId], references: [id])

  nextLedgerEntries LedgerEntry[] @relation("LedgerChain")

  @@index([deviceId])
  @@index([previousLedgerId])
}

// =====================================================
// VERIFICATION
// =====================================================

model Verification {
  id String @id @default(uuid()) @db.Uuid

  deviceId   String @db.Uuid
  verifiedBy String @db.Uuid

  timestamp DateTime @default(now())

  result String

  // Information about the broken record, if verification fails
  brokenRecord String?

  device Device @relation(fields: [deviceId], references: [id])

  verifier User @relation(fields: [verifiedBy], references: [id])

  @@index([deviceId])
  @@index([verifiedBy])
  @@index([timestamp])
}
